# Copy to .env and adjust. No secrets are required to run the site locally.

# Absolute public URL of the deployed site. Used for canonical URLs,
# Open Graph URLs, sitemap.xml and robots.txt. No trailing slash.
VITE_SITE_URL=http://localhost:5173

# Optional: live course source. When set, the catalog is fetched from this URL
# (it must return the same JSON array shape as src/data/courses.json).
# The original portal's public, read-only Product list is:
#   https://base44.app/api/apps/69d78f58013c9d6abf31e92d/entities/Product?sort=-created_date&limit=50
# Leave empty to use the bundled catalog snapshot.
VITE_COURSES_URL=

# Optional: endpoint that receives cart orders as a JSON POST.
# Leave empty to keep orders in the browser (localStorage key "hca_orders").
VITE_ORDER_ENDPOINT=
